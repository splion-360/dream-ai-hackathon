# Directory where each lesson job stores its MP4 and render.json diagnostics.
MATH_TUTOR_ARTIFACT_ROOT=artifacts

# Digest-pinned Manim Community image verified by the integration test.
MATH_TUTOR_MANIM_IMAGE=manimcommunity/manim@sha256:ab5ad56cf685d89da96e5d459e0cde3743fbdf2141be4dcff6c26566b5ca3191

# Hard wall-clock limit for one render container.
MATH_TUTOR_RENDER_TIMEOUT_SECONDS=90
